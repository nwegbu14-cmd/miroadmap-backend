# Supabase project settings. Keep the service-role key on this server only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Use the direct or pooled Postgres URL used by the Prisma 8 schema package.
DATABASE_URL=postgresql://postgres:password@localhost:5432/miroadmap

PORT=5001
FRONTEND_URL=http://127.0.0.1:3000,http://localhost:3000

# Bootstrap access: authenticated users with one of these emails are promoted
# to SUPER_ADMIN when POST /api/auth/profile is called.
SUPER_ADMIN_EMAILS=owner@example.com

# Roadmap Copilot. This key is read by the backend only and must never use a
# NEXT_PUBLIC_ prefix. ANTHROPIC_MODEL is optional.
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5

# Stripe Billing test mode. Never place these secrets in the frontend or use a
# live-mode key during product testing. Price IDs come from recurring Stripe
# test-mode Prices and may alternatively be stored in Plan.providerPriceId.
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-local-or-test-endpoint-secret
STRIPE_TRIAL_DAYS=7
STRIPE_PRICE_PREMIUM_MONTH=price_your-premium-monthly-id
STRIPE_PRICE_PREMIUM_YEAR=price_your-premium-yearly-id
STRIPE_PRICE_ULTIMATE_MONTH=price_your-ultimate-monthly-id
STRIPE_PRICE_ULTIMATE_YEAR=price_your-ultimate-yearly-id
