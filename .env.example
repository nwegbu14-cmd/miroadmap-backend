# Production. For local development copy `.env.local.example` instead.
# NODE_ENV=production also keeps DISABLE_RATE_LIMITS from having any effect.
NODE_ENV=production

# Supabase project settings. Keep the service-role key on this server only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Pooled Postgres URL of the production database.
DATABASE_URL=postgresql://user:password@your-db-host:5432/miroadmap

PORT=5001
# Public site origin(s), comma separated, no trailing slash. Browsers call the
# API directly, so this list is also the CORS allow-list.
FRONTEND_URL=https://miroadmap.co,https://www.miroadmap.co

# Bootstrap access: authenticated users with one of these emails are promoted
# to SUPER_ADMIN when POST /api/auth/profile is called.
SUPER_ADMIN_EMAILS=owner@example.com

# Outgoing mail for non-auth messages (newsletter and partnership emails). Use
# the same SMTP provider and sender as Supabase Auth (Dashboard > Authentication
# > Emails > SMTP Settings) and verify the sending domain (SPF, DKIM, DMARC).
# Port 587 (STARTTLS) or 465 (TLS). With SMTP_HOST unset, mail is skipped and
# the server logs a warning at startup.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password-or-api-key
MAIL_FROM=MiRoadmap <no-reply@miroadmap.co>
# Receives new-subscriber and partnership-inquiry notices. The old name
# NEWSLETTER_NOTIFY_EMAIL is still read when this one is unset.
TEAM_NOTIFY_EMAIL=inquire@miroadmap.co
# Public URLs used inside emails: this API (confirm and unsubscribe links) and
# the website. Both must be reachable from the internet.
API_PUBLIC_URL=https://api.miroadmap.co
PUBLIC_SITE_URL=https://miroadmap.co
# Optional. Defaults to a key derived from SUPABASE_SERVICE_ROLE_KEY, so rotating
# that key invalidates outstanding email links. Set it to keep links stable.
# NEWSLETTER_TOKEN_SECRET=

# Roadmap Copilot. This key is read by the backend only and must never use a
# NEXT_PUBLIC_ prefix. ANTHROPIC_MODEL is optional.
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5

# Stripe Billing, live mode. Never place these secrets in the frontend. Create
# the webhook endpoint for the production API in the live-mode dashboard and use
# its signing secret. Price IDs come from live-mode recurring Prices and may
# alternatively be stored in Plan.providerPriceId.
STRIPE_SECRET_KEY=sk_live_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-production-endpoint-secret
STRIPE_TRIAL_DAYS=7
STRIPE_PRICE_PREMIUM_MONTH=price_your-live-premium-monthly-id
STRIPE_PRICE_PREMIUM_YEAR=price_your-live-premium-yearly-id
STRIPE_PRICE_ULTIMATE_MONTH=price_your-live-ultimate-monthly-id
STRIPE_PRICE_ULTIMATE_YEAR=price_your-live-ultimate-yearly-id
