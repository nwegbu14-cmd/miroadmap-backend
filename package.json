{
  "name": "miroadmap-backend",
  "version": "1.0.0",
  "description": "backend for miRoadmap",
  "main": "index.js",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": "24.15.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsx watch index.ts",
    "start": "node --import tsx index.ts",
    "seed:featured-roadmaps": "tsx src/scripts/seed-featured-roadmaps.ts",
    "repair:roadmap-task-metadata": "node --import tsx src/scripts/repair-roadmap-task-metadata.ts",
    "seed:stories": "tsx src/scripts/seed-stories.ts",
    "test": "node --import tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "author": "davvvead",
  "license": "ISC",
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "dotenv": "^17.2.2",
    "express": "^5.2.1",
    "stripe": "^22.6.2",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
